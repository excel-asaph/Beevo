r\"><div onmouseover=\"highlight('grid')\" class=\"group cursor-pointer p-6 border-l-2 border-[#2D5A27] bg-[#2D5A27]/5 hover:bg-[#2D5A27]/10 transition-all\"><span class=\"text-[#2D5A27] text-xs block mb-1 font-semibold tracking-widest\">SPEC_03</span><h3 class=\"text-xl font-bold mb-2 uppercase tracking-wide\">Grid Integration Logic</h3><p class=\"text-sm text-[#F4F1DE]/70 leading-relaxed\">4.2x Energy ROI via localized sustainable charging infrastructure.</p></div><div onmouseover=\"highlight('mesh')\" class=\"group cursor-pointer p-6 border-l-2 border-[#40E0D0] bg-[#40E0D0]/5 hover:bg-[#40E0D0]/10 transition-all\"><span class=\"text-[#40E0D0] text-xs block mb-1 font-semibold tracking-widest\">SPEC_04</span><h3 class=\"text-xl font-bold mb-2 uppercase tracking-wide\">Resilient Mesh Network</h3><p class=\"text-sm text-[#F4F1DE]/70 leading-relaxed\">Latency: <15ms V2X connectivity in decentralized nodes.</p></div></div><div id=\"schematic-hub\" class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 hidden md:block pointer-events-none\"><div class=\"w-48 h-48 rounded-full border border-[#40E0D0]/30 flex items-center justify-center animate-spin-slow\"><div class=\"w-32 h-32 rounded-full border-2 border-dashed border-[#F4F1DE]/20\"></div></div><div id=\"status-indicator\" class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center\"><span class=\"text-[10px] tracking-[0.3em] text-[#40E0D0] uppercase\">Sync Status</span><div class=\"text-2xl font-bold\">ACTIVE</div></div></div></div><script>function highlight(id){const status = document.getElementById('status-indicator');const colors = {'geo': '#40E0D0', 'policy': '#E2725B', 'grid': '#2D5A27', 'mesh': '#40E0D0'};status.style.color = colors[id];status.innerHTML = '<span class=\"text-[10px] tracking-[0.3em] uppercase\">Linked</span><div class=\"text-2xl font-bold\">READY</div>';}</script></div>"
