            },
            {
                "id": "testimonial_002",
                "name": "Elena Rodriguez",
                "title": "Lead Stylist",
                "company": "Urban Fashion",
                "quote": "The craftsmanship rivals the houses in Paris, but the heart is strictly for the streets. This is the inclusion the industry has been avoiding for decades.",
                "image_prompt": "Professional headshot of a Latina woman in her 30s with creative styling, urban luxury aesthetic, soft focus background.",
                "image_url": "/workspaces/a107edc7_velocity/assets/history/social_v1770316439670/testimonial_2_1770316455390.png"
